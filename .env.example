# Copy this file to .env for local overrides. .env is in .gitignore: never commit it.
#
# Default: Mistral models on Amazon Bedrock. No key needed here: sign in with `aws login`.
# LLM_PROVIDER=bedrock
# BEDROCK_REGION=eu-west-1
#
# Or the Mistral API (needs a Mistral plan that includes API access):
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=
#
# Optional model overrides
# ANSWER_MODEL=mistral.ministral-3-14b-instruct
# JUDGE_MODEL=eu.mistral.pixtral-large-2502-v1:0
